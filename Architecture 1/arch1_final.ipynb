        "    plt.figure(figsize=(10, 8))\n",
        "    scatter = plt.scatter(proj[:, 0], proj[:, 1],\n",
        "                          c=cor_labels, cmap=\"RdYlBu_r\",\n",
        "                          alpha=0.7, s=15)\n",
        "    plt.colorbar(scatter, label=\"Coefficient of Restitution\")\n",
        "    plt.title(title)\n",
        "    plt.xlabel(\"t-SNE dim 1\")\n",
        "    plt.ylabel(\"t-SNE dim 2\")\n",
